{
  "name": "fisamtour-licitacoes-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend leve (Vercel serverless + Supabase/Postgres) para o Portal de Licitações FISAMTOUR, substituindo o Google Apps Script.",
  "main": "api/index.js",
  "scripts": {
    "dev": "node local-server.js",
    "migrate:schema": "psql \"$DATABASE_URL\" -f migrations/schema.sql",
    "migrate:csv": "node scripts/migrate-csv.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5"
  }
}
