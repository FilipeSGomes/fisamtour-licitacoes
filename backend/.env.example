# String de conexão do Supabase (Project Settings -> Database -> Connection string -> URI).
# Use a porta 6543 (pooler/pgbouncer) se disponível, para funcionar bem em serverless.
DATABASE_URL=postgres://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres

# Mesmo token que o frontend (js/api.js) envia — troque por um novo valor,
# o token antigo do Apps Script já está exposto no histórico do git.
API_TOKEN=troque-este-token

# Origens autorizadas a chamar a API (separadas por vírgula).
ALLOWED_ORIGINS=https://ponto.fisamtour.com,http://localhost:5500

PORT=3001
