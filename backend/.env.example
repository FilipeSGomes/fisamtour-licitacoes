# Copie para backend/.env e preencha ADMIN_PASSWORD só na sua máquina.
# A senha abaixo é do Postgres de desenvolvimento definido em docker-compose.yml.
DATABASE_URL=postgres://fisam:fisam_dev@127.0.0.1:54329/fisam_ponto

# Primeiro administrador. O servidor só cria este usuário quando a tabela users está vazia.
# Não commite o .env. Não reutilize esta senha fora da sua máquina.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

PORT=3001
# 1 apenas atrás de HTTPS. Em localhost deixe 0, senão o cookie de sessão não grava.
COOKIE_SECURE=0
# require somente se o Postgres exigir TLS. Localmente deixe vazio.
DATABASE_SSL=
